import <hydra/sharedConfig>
import <hydra/eventProcessing>
import <content_understanding/tweetUtil>

type PhoenixRankAllIndexingRequest = com.twitter.strato.columns.hydra.PhoenixRankAllIndexingRequest
type Tweet = com.twitter.tweetypie.Tweet
type UnifiedPostAnnotations = com.twitter.strato.columns.content_understanding.UnifiedPostAnnotations
type EngagementCount = com.twitter.strato.columns.hydra.EngagementCount
type PhoenixRankAllCandidate = com.twitter.strato.columns.hydra.PhoenixRankAllCandidate
type PhoenixRankAllObject = com.twitter.strato.columns.hydra.PhoenixRankAllObject
type FilteredTopicsByExperiment = com.twitter.strato.columns.hydra.FilteredTopicsByExperiment

val postMultimodalEmbeddingMhColumnV2 = #<searchai/storage/postMultimodalEmbeddingMhV2>


def buildAdsIndex(candidate: PhoenixRankAllCandidate, stats: Stats.StatsReceiver): Unit = {
  val object = {
    postId = candidate.postId,
    authorId = candidate.authorId,
    indexName = "ads"
  }
  #<hydra/kafka/indexingEventKafkaTopic>.insert((), object)
  stats.counter("ads_indexing_event_created").incr(1)
}

