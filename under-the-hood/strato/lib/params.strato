import <strato/featureswitches>

val userRoles = Set(
  "birdwatch_team",
  "employee",
)

val fs = featureswitches.build({
  getParamValue = { case (paramName, recipient) =>
    #<visibility/under-the-hood/featureSwitches>.fetch(paramName, recipient).v
  },
  userRoles = Some(userRoles),
})

val underTheHoodReportEnabled =
  fs.booleanParam("under_the_hood_report_enabled", false)

val underTheHoodReportMaxMonthBucket =
  fs.intParam("under_the_hood_report_max_month_bucket", 0)

val underTheHoodReportTakedownsEnabled =
  fs.booleanParam("under_the_hood_report_takedowns_enabled", false)

val underTheHoodReportAccountAffinitiesEnabled =
  fs.booleanParam("under_the_hood_report_account_affinities_enabled", false)

Library({
  export = {
    underTheHoodReportEnabled = underTheHoodReportEnabled,
    underTheHoodReportMaxMonthBucket = underTheHoodReportMaxMonthBucket,
    underTheHoodReportTakedownsEnabled = underTheHoodReportTakedownsEnabled,
    underTheHoodReportAccountAffinitiesEnabled = underTheHoodReportAccountAffinitiesEnabled,
  },
  description = PlainText("Feature switch params for Under the Hood"),
  contactInfo = <visibility/under-the-hood/sharedConfig>.contactInfo,
  lifecycle = Production,
})
