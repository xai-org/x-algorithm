import <strato/featureswitches>

val userRoles = Set(
  "birdwatch_team",
  "employee",
)

val fs = featureswitches.build({
  getParamValue = { case (paramName, recipient) =>
    #<visibility/under-the-hood/featureSwitches>.fetch(paramName, recipient).v
  },
  userRoles = Some(userRoles),
})

val underTheHoodReportEnabled =
  fs.booleanParam("under_the_hood_report_enabled", false)

val underTheHoodReportMaxMonthBucket =
  fs.intParam("under_the_hood_report_max_month_bucket", 0)

val underTheHoodReportTakedownsEnabled =
  fs.booleanParam("under_the_hood_report_takedowns_enabled", false)

val underTheHoodReportAppealsEnabled =
  fs.booleanParam("under_the_hood_report_appeals_enabled", false)

val sensitiveMediaAppealAuthorWarningEnabled =
  fs.booleanParam("sensitive_media_appeal_author_warning_enabled", false)

val underTheHoodReportPostIdsEnabled =
  fs.booleanParam("under_the_hood_report_post_ids_enabled", false)
val underTheHoodReportPostIdsAlwaysShowUpTo =
  fs.intParam("under_the_hood_report_post_ids_always_show_up_to", 3)
val underTheHoodReportPostIdsMaxSharePct =
  fs.intParam("under_the_hood_report_post_ids_max_share_pct", 5)
val underTheHoodReportPostIdsMaxPerLabel =
  fs.intParam("under_the_hood_report_post_ids_max_per_label", 50)

Library({
  export = {
    underTheHoodReportEnabled = underTheHoodReportEnabled,
    underTheHoodReportMaxMonthBucket = underTheHoodReportMaxMonthBucket,
    underTheHoodReportTakedownsEnabled = underTheHoodReportTakedownsEnabled,
    underTheHoodReportAppealsEnabled = underTheHoodReportAppealsEnabled,
    sensitiveMediaAppealAuthorWarningEnabled = sensitiveMediaAppealAuthorWarningEnabled,
    underTheHoodReportPostIdsEnabled = underTheHoodReportPostIdsEnabled,
    underTheHoodReportPostIdsAlwaysShowUpTo = underTheHoodReportPostIdsAlwaysShowUpTo,
    underTheHoodReportPostIdsMaxSharePct = underTheHoodReportPostIdsMaxSharePct,
    underTheHoodReportPostIdsMaxPerLabel = underTheHoodReportPostIdsMaxPerLabel,
  },
  description = PlainText("Feature switch params for Under the Hood"),
  contactInfo = <visibility/under-the-hood/sharedConfig>.contactInfo,
  lifecycle = Production,
})
