val worldwideCode = "xx"
val worldwideCopyrightCode = "xy"
val countriesPlaceholder = Regex.compile("\\{countries\\}")
val takedownNamesWithCountries = Set("LegalRequest", "BystanderReport", "UnspecifiedReason")
val takedownNamesWithoutCountries = Set("Dmca", "is_dmca")
val servedPostTakedownReasons: Set[String] = takedownNamesWithCountries ++ takedownNamesWithoutCountries

val postTakedowns = Map(
  "BystanderReport(country)" -> {
    about =
      "Post withheld where the content has been found to violate local law(s) following a third-party report.",
    effect = "Post is not shown on X in {countries} where it violates local law(s).",
  },
  "LegalRequest(country)" -> {
    about = "Post has been withheld in response to a legal demand.",
    effect = "Post is not shown on X in {countries} where it violates local law(s).",
  },
  "UnspecifiedReason(country)" -> {
    about =
      "Historically applied to posts withheld in response to a legal demand or if found to violate local law(s) following a third-party report.",
    effect = "Post is not shown on X in {countries} where it violates local law(s).",
  },
  "LegalRequest(xx)" -> {
    about = "Post has been withheld in response to a legal demand.",
    effect = "Post is not shown on X.",
  },
  "UnspecifiedReason(xx)" -> {
    about =
      "Historically applied to posts withheld in response to a legal demand or if found to violate local law(s) following a third-party report.",
    effect = "Post is not shown on X.",
  },
  "UnspecifiedReason(xy)" -> {
    about =
      "Applied in response to a report from a copyright holder or authorized representative to content found to violate X's Copyright policy. Applied along with the DMCA label.",
    effect = "Post is not shown on X.",
  },
  "Dmca" -> {
    about =
      "Applied in response to a report from a copyright holder or authorized representative to content found to violate X's Copyright policy.",
    effect = "Post is not shown on X.",
  },
  "is_dmca" -> {
    about =
      "Applied in response to a report from a copyright holder or authorized representative to content found to violate X's Copyright policy.",
    effect =
      "Post hidden from recommendations to non-followers. Where the post is seen, media in the post is unavailable.",
  },
)

val accountTakedowns = Map(
  "BystanderReport(country)" -> {
    about =
      "Posts from this account withheld where the account has been found to violate local law(s) following a third-party report.",
    effect = "This account's posts are not shown on X in {countries} where it violates local law(s).",
  },
  "LegalRequest(country)" -> {
    about = "Posts from this account withheld in response to a legal demand.",
    effect = "This account's posts are not shown on X in {countries} where it violates local law(s).",
  },
  "UnspecifiedReason(country)" -> {
