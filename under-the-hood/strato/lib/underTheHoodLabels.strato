      "Historically applied to accounts withheld in response to a legal demand or if found to violate local law(s) following a third-party report.",
    effect = "This account's posts are not shown on X in {countries} where it violates local law(s).",
  },
  "LegalRequest(xx)" -> {
    about = "Posts from this account withheld in response to a legal demand.",
    effect = "This account's posts are not shown on X.",
  },
  "UnspecifiedReason(xx)" -> {
    about =
      "Historically applied to accounts withheld in response to a legal demand or if found to violate local law(s) following a third-party report.",
    effect = "This account's posts are not shown on X.",
  },
)

def upperCodes(countryCodes: Seq[String]): String =
  countryCodes.map { c => c.toUpperCase }.mkString(", ")

def takedownCopyKey(label: String, countryCodes: Seq[String]): Option[String] =
  if (takedownNamesWithoutCountries.contains(label)) {
    Some(label)
  } else if (!takedownNamesWithCountries.contains(label)) {
    None
  } else if (countryCodes.exists { c => c == worldwideCode }) {
    Some(label + "(xx)")
  } else if (countryCodes.exists { c => c == worldwideCopyrightCode }) {
    Some(label + "(xy)")
  } else if (countryCodes.isEmpty) {
    None
  } else {
    Some(label + "(country)")
  }

def fillCountries(text: String, countryCodes: Seq[String]): String =
  countriesPlaceholder.replaceAll(text, upperCodes(countryCodes))

def takedownLabelName(label: String, countryCodes: Seq[String]): String =
  if (takedownNamesWithCountries.contains(label) && countryCodes.nonEmpty) {
    label + "(" + upperCodes(countryCodes) + ")"
  } else {
    label
  }

def postTakedownInfo(
    label: String,
    countryCodes: Seq[String]
): Option[{ about: String, effect: String }] =
  takedownCopyKey(label, countryCodes).flatMap { k => postTakedowns.get(k) }.map { info =>
    { about = info.about, effect = fillCountries(info.effect, countryCodes) }
  }

def accountTakedownInfo(
    label: String,
    countryCodes: Seq[String]
): Option[{ about: String, effect: String }] =
  takedownCopyKey(label, countryCodes).flatMap { k => accountTakedowns.get(k) }.map { info =>
    { about = info.about, effect = fillCountries(info.effect, countryCodes) }
  }

def isPostTakedownLabel(label: String, countryCodes: Seq[String]): Boolean =
  postTakedownInfo(label, countryCodes) match {
    case Some(_) => true
    case None => false
  }

def isAccountTakedownLabel(label: String, countryCodes: Seq[String]): Boolean =
  accountTakedownInfo(label, countryCodes) match {
    case Some(_) => true
    case None => false
  }

def postTakedownAbout(label: String, countryCodes: Seq[String]): String =
  postTakedownInfo(label, countryCodes) match {
    case Some(i) => i.about
    case None => ""
  }

def postTakedownEffect(label: String, countryCodes: Seq[String]): String =
  postTakedownInfo(label, countryCodes) match {
    case Some(i) => i.effect
    case None => ""
  }

def accountTakedownAbout(label: String, countryCodes: Seq[String]): String =
  accountTakedownInfo(label, countryCodes) match {
    case Some(i) => i.about
    case None => ""
  }

def accountTakedownEffect(label: String, countryCodes: Seq[String]): String =
  accountTakedownInfo(label, countryCodes) match {
    case Some(i) => i.effect
    case None => ""
  }

val underscore = Regex.compile("_")

def normalizeLabel(code: String): String =
  underscore.replaceAll(code, "").toUpperCase

def resolvePostKey(code: String): Option[String] = {
  val n = normalizeLabel(code)
  val direct = postLabels.keys.filter { k => normalizeLabel(k) == n }.headOption
  direct match {
    case Some(k) => Some(k)
    case None =>
      postLabelAliases.keys
        .filter { k => normalizeLabel(k) == n }
        .headOption
        .flatMap { alias => postLabelAliases.get(alias) }
  }
}

def resolveAccountKey(code: String): Option[String] =
  accountLabels.keys.filter { k => normalizeLabel(k) == normalizeLabel(code) }.headOption

def isPostLabel(code: String): Boolean =
  resolvePostKey(code) match {
    case Some(_) => true
    case None => false
  }

def isAccountLabel(code: String): Boolean =
  resolveAccountKey(code) match {
    case Some(_) => true
    case None => false
  }

def postLabelName(code: String): String =
  resolvePostKey(code) match {
    case Some(k) => k
    case None => code
  }

def accountLabelName(code: String): String =
  resolveAccountKey(code) match {
    case Some(k) => k
    case None => code
  }

def postLabelAbout(code: String): String =
  resolvePostKey(code) match {
    case Some(k) =>
      postLabels.get(k) match {
        case Some(info) => info.about
        case None => ""
      }
    case None => ""
  }

def accountLabelAbout(code: String): String =
  resolveAccountKey(code) match {
    case Some(k) =>
      accountLabels.get(k) match {
        case Some(info) => info.about
        case None => ""
      }
    case None => ""
  }

def postLabelEffect(code: String): String =
  resolvePostKey(code) match {
    case Some(k) =>
      postLabels.get(k) match {
        case Some(info) => info.effect
        case None => ""
      }
    case None => ""
  }

def accountLabelEffect(code: String): String =
  resolveAccountKey(code) match {
    case Some(k) =>
      accountLabels.get(k) match {
        case Some(info) => info.effect
        case None => ""
      }
    case None => ""
  }

type AppealSpan = {
  text: String,
  url: Option[String]
}

type WithholdAppealForm = {
  name: String,
  countries: Set[String],
  url: String
}

val appealFromPost = "If the post still has this label, you can appeal from the post."
val enforcementEmail = "Instructions provided in email notification at the time of enforcement."
val counterNoticeUrl = "https://help.x.com/forms/ipi/dmca-counternotice"
val japanAppealUrl = "https://help.x.com/forms/ld/appeal"
val japanCode = "jp"

val euCountryCodes = Set(
  "at", "be", "bg", "cy", "cz", "de", "dk", "ee", "es", "fi", "fr", "gr", "hr", "hu",
  "ie", "it", "lt", "lu", "lv", "mt", "nl", "pl", "pt", "ro", "se", "si", "sk",
)

val bystanderAppealForms: Seq[WithholdAppealForm] = Seq(
  { name = "the UK", countries = Set("gb"), url = "https://help.x.com/forms/osa/appeal" },
  { name = "the EU", countries = euCountryCodes, url = "https://help.x.com/forms/dsa/appeal" },
  {
    name = "Australia",
    countries = Set("au"),
    url = "https://help.x.com/forms/australia-report/appeal",
  },
  { name = "Brazil", countries = Set("br"), url = "https://help.x.com/forms/br/appeal" },
)

val fosnrPostLabels = Set(
  "FOSNR_ABUSE",
  "FOSNR_HATEFUL_CONDUCT",
  "FOSNR_VIOLENT_SPEECH",
  "FOSNR_CIVIC_INTEGRITY",
  "FOSNR_ABUSE_INSULTS",
)
val sensitiveMediaPostLabels = Set("NSFW_HIGH_PRECISION", "NSFW_CARD_IMAGE")

def textSpan(text: String): AppealSpan = { text = text, url = None : Option[String] }

def linkSpan(text: String, url: String): AppealSpan = { text = text, url = Some(url) }

def linkedSentence(text: String, url: String): Seq[AppealSpan] =
  Seq(textSpan(" "), linkSpan(text, url), textSpan("."))

def postLabelAppeal(code: String, sensitiveMediaAppealFromPost: Boolean): Option[Seq[AppealSpan]] =
  resolvePostKey(code) match {
    case Some(k)
        if fosnrPostLabels.contains(k) ||
          (sensitiveMediaAppealFromPost && sensitiveMediaPostLabels.contains(k)) =>
      Some(Seq(textSpan(appealFromPost)))
    case Some(k) if k == "BOUNCE" =>
      Some(Seq(textSpan(enforcementEmail)))
    case _ =>
      None
  }

def bystanderReportAppeal(countryCodes: Seq[String]): Option[Seq[AppealSpan]] = {
  val forms = bystanderAppealForms.filter { f => countryCodes.exists { c => f.countries.contains(c) } }
  if (forms.isEmpty) {
    None
  } else {
    Some(Seq(textSpan(enforcementEmail)) ++ forms.map { f =>
      linkedSentence("Appeal this withholding in " + f.name, f.url)
    }.flatten)
  }
}

def legalRequestAppeal(countryScoped: Boolean, countryCodes: Seq[String]): Seq[AppealSpan] = {
  val reply = Seq(textSpan(enforcementEmail + " Appeal by responding to the email."))
  if (countryScoped && countryCodes.contains(japanCode)) {
    reply ++ linkedSentence("Appeal this withholding in Japan", japanAppealUrl)
  } else {
    reply
  }
}

def takedownAppeal(label: String, countryCodes: Seq[String]): Option[Seq[AppealSpan]] =
  takedownCopyKey(label, countryCodes).flatMap { k =>
    if (takedownNamesWithoutCountries.contains(k) || k == label + "(xy)") {
      Some(
        Seq(textSpan(enforcementEmail)) ++
          linkedSentence("Appeal by submitting a counter-notice", counterNoticeUrl))
    } else if (label == "BystanderReport") {
      bystanderReportAppeal(countryCodes)
    } else if (label == "LegalRequest") {
      Some(legalRequestAppeal(k == label + "(country)", countryCodes))
    } else {
      None
    }
  }

Library({
  export = {
    postLabels = postLabels,
    postLabelAliases = postLabelAliases,
    servedPostLabels = servedPostLabels,
    servedPostTakedownReasons = servedPostTakedownReasons,
    accountLabels = accountLabels,
    normalizeLabel = normalizeLabel,
    resolvePostKey = resolvePostKey,
    resolveAccountKey = resolveAccountKey,
    isPostLabel = isPostLabel,
    isAccountLabel = isAccountLabel,
    postLabelName = postLabelName,
    accountLabelName = accountLabelName,
    postLabelAbout = postLabelAbout,
    accountLabelAbout = accountLabelAbout,
    postLabelEffect = postLabelEffect,
    accountLabelEffect = accountLabelEffect,
    postTakedowns = postTakedowns,
    accountTakedowns = accountTakedowns,
    takedownLabelName = takedownLabelName,
    isPostTakedownLabel = isPostTakedownLabel,
    isAccountTakedownLabel = isAccountTakedownLabel,
    postTakedownAbout = postTakedownAbout,
    postTakedownEffect = postTakedownEffect,
    accountTakedownAbout = accountTakedownAbout,
    accountTakedownEffect = accountTakedownEffect,
    postLabelAppeal = postLabelAppeal,
    takedownAppeal = takedownAppeal,
  },
  description = PlainText(
    "Under the Hood public label and takedown allowlists (canonical name -> about/effect), " +
      "how to appeal each, and helpers."
  ),
  contactInfo = sharedConfig.contactInfo,
  lifecycle = Production,
})
