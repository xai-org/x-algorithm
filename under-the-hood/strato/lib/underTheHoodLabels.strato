def postLabelScope(code: String): String =
  resolvePostKey(code) match {
    case Some(k) =>
      postLabels.get(k) match {
        case Some(info) => info.scope
        case None => "Post-level"
      }
    case None => "Post-level"
  }

def accountLabelScope(code: String): String =
  resolveAccountKey(code) match {
    case Some(k) =>
      accountLabels.get(k) match {
