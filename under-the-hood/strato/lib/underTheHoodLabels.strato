        case None => ""
      }
    case None => ""
  }

Library({
  export = {
    postLabels = postLabels,
    postLabelAliases = postLabelAliases,
    accountLabels = accountLabels,
    normalizeLabel = normalizeLabel,
    resolvePostKey = resolvePostKey,
    resolveAccountKey = resolveAccountKey,
    isPostLabel = isPostLabel,
    isAccountLabel = isAccountLabel,
    postLabelName = postLabelName,
    accountLabelName = accountLabelName,
    postLabelAbout = postLabelAbout,
    accountLabelAbout = accountLabelAbout,
    postLabelEffect = postLabelEffect,
    accountLabelEffect = accountLabelEffect,
    postLabelReason = postLabelReason,
    accountLabelReason = accountLabelReason,
    postLabelRestriction = postLabelRestriction,
    accountLabelRestriction = accountLabelRestriction,
    postLabelScope = postLabelScope,
    accountLabelScope = accountLabelScope,
    postLabelAffectedTarget = postLabelAffectedTarget,
    accountLabelAffectedTarget = accountLabelAffectedTarget,
    postTakedowns = postTakedowns,
    accountTakedowns = accountTakedowns,
    takedownLabelName = takedownLabelName,
    isPostTakedownLabel = isPostTakedownLabel,
    isAccountTakedownLabel = isAccountTakedownLabel,
    postTakedownAbout = postTakedownAbout,
    postTakedownEffect = postTakedownEffect,
    accountTakedownAbout = accountTakedownAbout,
    accountTakedownEffect = accountTakedownEffect,
  },
  description = PlainText(
    "Under the Hood public label and takedown allowlists (canonical name -> about/effect/reason/restriction/scope/affectedTarget) and helpers."
  ),
  contactInfo = sharedConfig.contactInfo,
  lifecycle = Production,
})
